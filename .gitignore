# Jupyter — sample notebooks under stack/code/notebook ARE tracked as teaching
# material. Only checkpoints and papermill-generated output are ignored.
**/.ipynb_checkpoints/
stack/code/notebook/output.ipynb

# Auto-push: the de-lab clone that local Jupyter creates for save-and-push.
# It has its own git remote (and a token in its .git/config) — never commit it
# into this repo.
local/code/notebook/repo/

# Local env holds the git PAT (GIT_TOKEN) + host config — never commit it.
# Copy local/.env.example -> local/.env and fill it in.
local/.env

# Misc
notes.txt

# AdventureWorks sample data staged by `make init` (~110 MB, generated — not committed).
# The init script + Trino catalog ARE committed; only the downloaded CSVs/install.sql aren't.
local/init_scripts/postgres/adventureworks/

# make up / make status: run log + what the images were built from (tools/up.py)
local/logs/
