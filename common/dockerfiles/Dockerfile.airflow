# Python 3.10 on purpose: spark-submit runs the PySpark driver HERE while executors run
# in the spark image (Ubuntu 22.04, Python 3.10) — driver and worker Python must match.
FROM apache/airflow:3.3.2-python3.10
# mc: mints each learner's own storage key for their DAG tasks (lab_spark), like JupyterHub does
COPY --from=ghcr.io/maarthala/de-stack/mc:RELEASE.2025-08-13T08-35-41Z /usr/bin/mc /usr/local/bin/mc

USER root

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        openjdk-17-jre-headless \
        wget \
        curl \
        unzip \
        zip \
        procps \
    && rm -rf /var/lib/apt/lists/*

# Install Spark
COPY ./tmp/spark-4.1.3-bin-hadoop3.tgz .
RUN tar -xzf spark-4.1.3-bin-hadoop3.tgz -C /opt && \
    ln -s /opt/spark-4.1.3-bin-hadoop3 /opt/spark && \
    rm spark-4.1.3-bin-hadoop3.tgz


COPY ./tmp/postgresql-42.6.0.jar /opt/spark/jars/
COPY ./tmp/hadoop-aws-3.4.2.jar /opt/spark/jars/
COPY ./tmp/bundle-2.29.52.jar /opt/spark/jars/
COPY ./tmp/javax.activation-api-1.2.0.jar /opt/spark/jars/
COPY ./tmp/jaxb-api-2.3.1.jar /opt/spark/jars/
COPY ./tmp/jaxb-impl-2.3.1.jar /opt/spark/jars/
COPY ./tmp/iceberg-spark-runtime-4.1_2.13-1.11.0.jar /opt/spark/jars/
COPY ./tmp/iceberg-aws-bundle-1.11.0.jar /opt/spark/jars/

# Same jar hygiene as Dockerfile.spark so SparkSubmitOperator jobs run here:
# strip the unrelocated io.netty from the AWS SDK bundle (it shadows Spark 4's
# netty-common -> NoSuchMethodError on SparkContext init). hive-exec-3.1.3 /
# hive-hcatalog-core-3.1.2 are deliberately NOT added — they shadow commons-lang3
# (NoSuchFieldError JAVA_21); Spark 4 uses its bundled hive-2.3.10 client.
RUN zip -q -d /opt/spark/jars/bundle-2.29.52.jar 'io/netty/*' 'META-INF/native/libnetty*' || true

# Delta Lake — spark-defaults.conf (shared with the Spark cluster) registers Delta's
# SQL extension + DeltaCatalog, so the driver here needs the same jars or every
# spark-submit fails on "Cannot find catalog plugin class". Same versions as Dockerfile.spark.
ARG DELTA_VER=4.4.0
ARG DELTA_SPARK=4.1
RUN cd /opt/spark/jars && \
    base=https://repo1.maven.org/maven2/io/delta && \
    curl -fsSL -O $base/delta-spark_${DELTA_SPARK}_2.13/${DELTA_VER}/delta-spark_${DELTA_SPARK}_2.13-${DELTA_VER}.jar && \
    curl -fsSL -O $base/delta-storage/${DELTA_VER}/delta-storage-${DELTA_VER}.jar && \
    curl -fsSL -O $base/delta-kernel-api/${DELTA_VER}/delta-kernel-api-${DELTA_VER}.jar && \
    curl -fsSL -O $base/delta-kernel-defaults/${DELTA_VER}/delta-kernel-defaults-${DELTA_VER}.jar

RUN chmod 777 /opt/spark/jars/*.jar

# Set environment variables

RUN [ -L /usr/lib/jvm/java-17 ] && rm /usr/lib/jvm/java-17 || true

RUN if [ -d /usr/lib/jvm/java-17-openjdk-amd64 ]; then \
        ln -sf /usr/lib/jvm/java-17-openjdk-amd64 /usr/lib/jvm/java-17; \
    elif [ -d /usr/lib/jvm/java-17-openjdk-arm64 ]; then \
        ln -sf /usr/lib/jvm/java-17-openjdk-arm64 /usr/lib/jvm/java-17; \
    fi

ENV JAVA_HOME=/usr/lib/jvm/java-17

ENV SPARK_HOME=/opt/spark
ENV PATH=$SPARK_HOME/bin:$JAVA_HOME/bin:$PATH


# dbt for learner DAGs (lab_dbt() in lab_spark.py): its own venv, same versions as Jupyter, with
# its own pyspark-client (the image's packages are per-user, which a venv can't see). The wrapper
# hides dbt-spark's harmless "catalogImplementation" warning, as in Jupyter.
RUN PIP_USER=false python -m venv /opt/dbt \
 && PIP_USER=false /opt/dbt/bin/pip install --no-cache-dir dbt-core==1.12.5 dbt-spark==1.11.0 pyspark-client==4.1.3 \
 && printf '%s\n' '#!/bin/sh' \
      '# dbt-spark always asks for Hive support, which Spark Connect ignores: hide that one warning' \
      'export PYTHONWARNINGS="ignore:Failed to set spark.sql.catalogImplementation:UserWarning${PYTHONWARNINGS:+,$PYTHONWARNINGS}"' \
      'exec /opt/dbt/bin/dbt "$@"' > /usr/local/bin/dbt \
 && chmod +x /usr/local/bin/dbt

USER airflow
ADD ./add/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Register the python3 kernel
RUN python -m ipykernel install --name python3 --display-name "Python 3" --user
