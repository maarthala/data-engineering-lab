# Thin Jupyter for Spark Connect. No Spark/JVM/conda baked in — notebooks talk to
# the spark-connect server pod over gRPC (sc://spark-connect:15002). This keeps the
# image small and, crucially, avoids the huge conda layer set that made containerd's
# overlayfs snapshotter spin on the LXC node. The heavy Spark lives in the reusable
# spark image (spark-connect deployment); this is just the client + notebooks.
# Python MUST match the Spark workers (spark:4.1.3-python3 ships 3.10) — Python UDFs
# fail with PYTHON_VERSION_MISMATCH otherwise. Airflow is pinned to 3.10 for the same reason.
FROM python:3.10-slim

# git + certs are needed for the auto-push-on-save workflow (clone the repo,
# commit + push each save). ca-certificates lets git talk HTTPS to GitHub.
RUN apt-get update \
 && apt-get install -y --no-install-recommends git ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# boto3: the AWS SDK the recipes use from notebooks (S3 API; pip matches it to s3fs's botocore).
# pyyaml: required by the Spark Declarative Pipelines CLI (`%%sql` materialized views).
# jupyterhub: the single-user server, so JupyterHub can run this image once per learner
# (same version as the Hub — Zero-to-JupyterHub 4.4.2 ships 5.5.2).
RUN pip install --no-cache-dir \
      jupyterlab \
      "jupyterhub==5.5.2" \
      pyspark-client==4.1.3 \
      pyyaml \
      pandas \
      numpy \
      pyarrow \
      grpcio \
      grpcio-status \
      requests \
      sqlalchemy \
      psycopg2-binary \
      trino \
      openpyxl \
      s3fs \
      boto3 \
      jupyter-fs

# dbt (the dbt course): own venv so its pins can't clash with Jupyter's packages. It sees the
# system site-packages for pyspark-client — dbt-spark's `session` method then runs every model
# through Spark Connect as the learner. NOT the dbt-spark[session] extra: that pulls a full pyspark.
RUN python -m venv --system-site-packages /opt/dbt \
 && /opt/dbt/bin/pip install --no-cache-dir dbt-core==1.12.5 dbt-spark==1.11.0 \
 && printf '%s\n' '#!/bin/sh' \
      '# dbt-spark always asks for Hive support, which Spark Connect ignores: hide that one warning' \
      'export PYTHONWARNINGS="ignore:Failed to set spark.sql.catalogImplementation:UserWarning${PYTHONWARNINGS:+,$PYTHONWARNINGS}"' \
      'exec /opt/dbt/bin/dbt "$@"' > /usr/local/bin/dbt \
 && chmod +x /usr/local/bin/dbt

# Non-root notebook user (uid 1000, "jovyan" to match convention).
RUN useradd -m -u 1000 -s /bin/bash jovyan

# pyspark's Connect client auto-uses SPARK_REMOTE, so notebooks can just do
# SparkSession.builder.getOrCreate() and land on the remote engine.
ENV SPARK_REMOTE=sc://spark-connect:15002

# Databricks-style: pre-create `spark` in every notebook via an IPython startup script.
RUN mkdir -p /home/jovyan/.ipython/profile_default/startup \
 && chown -R jovyan:jovyan /home/jovyan/.ipython
COPY --chown=jovyan:jovyan add/00-spark.py /home/jovyan/.ipython/profile_default/startup/00-spark.py

# Auto-push-on-save: the post-save hook lives in a system-level config (avoids the
# home-dir ownership pitfalls of mounting into ~/.jupyter), and the entrypoint
# clones/configures the repo when GIT_AUTOPUSH=1. Both are inert unless enabled.
COPY add/jupyter_server_config.py /etc/jupyter/jupyter_server_config.py
COPY add/lab_sync.py /etc/jupyter/lab_sync.py
COPY add/jupyter-entrypoint.sh /usr/local/bin/jupyter-entrypoint.sh
RUN chmod +x /usr/local/bin/jupyter-entrypoint.sh \
 && mkdir -p /home/jovyan/work && chown -R jovyan:jovyan /home/jovyan/work

USER jovyan
WORKDIR /home/jovyan
EXPOSE 8888

CMD ["bash","/usr/local/bin/jupyter-entrypoint.sh"]
