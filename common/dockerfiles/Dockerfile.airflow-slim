# Slim Airflow for Kubernetes: no baked-in Spark. Spark jobs are run in separate
# pods via KubernetesPodOperator (the cncf.kubernetes provider), so this image
# stays small and mounts fast.
FROM apache/airflow:3.3.2-python3.10
# mc: mints each learner's own storage key for their DAG tasks (lab_spark), like JupyterHub does
COPY --from=ghcr.io/maarthala/de-stack/mc:RELEASE.2025-08-13T08-35-41Z /usr/bin/mc /usr/local/bin/mc

# cncf.kubernetes = KubernetesPodOperator; papermill for the notebook DAG.
# pyspark-client = thin Spark Connect client (no JVM), so an Airflow @task can
# import shared src/mylib and drive sc://spark-connect:15002 in-process.
# Login: the lab account (Keycloak) through the FAB auth manager — the base image already
# ships the fab + amazon providers and authlib (webserver_config.py below).
# Pin airflow + install against the release's constraints so pip can't swap the
# core version or pull provider versions that weren't tested with it.
# pyspark-client is pinned to the Spark server version (4.1.3), overriding constraints.
ARG AIRFLOW_VERSION=3.3.2
RUN curl -fsSL -o /tmp/constraints.txt \
      "https://raw.githubusercontent.com/apache/airflow/constraints-${AIRFLOW_VERSION}/constraints-3.10.txt" \
 && sed -i '/^pyspark-client==/d' /tmp/constraints.txt \
 && pip install --no-cache-dir --constraint /tmp/constraints.txt \
      "apache-airflow==${AIRFLOW_VERSION}" \
      apache-airflow-providers-cncf-kubernetes \
      papermill \
      pyspark-client==4.1.3 \
      ipykernel \
 && python -m ipykernel install --user --name python3 --display-name "Python 3"

USER root
# dbt for learner DAGs (lab_dbt() in lab_spark.py): its own venv, same versions as Jupyter, with
# its own pyspark-client (the image's packages are per-user, which a venv can't see). The wrapper
# hides dbt-spark's harmless "catalogImplementation" warning, as in Jupyter.
RUN PIP_USER=false python -m venv /opt/dbt \
 && PIP_USER=false /opt/dbt/bin/pip install --no-cache-dir dbt-core==1.12.5 dbt-spark==1.11.0 pyspark-client==4.1.3 \
 && printf '%s\n' '#!/bin/sh' \
      '# dbt-spark always asks for Hive support, which Spark Connect ignores: hide that one warning' \
      'export PYTHONWARNINGS="ignore:Failed to set spark.sql.catalogImplementation:UserWarning${PYTHONWARNINGS:+,$PYTHONWARNINGS}"' \
      'exec /opt/dbt/bin/dbt "$@"' > /usr/local/bin/dbt \
 && chmod +x /usr/local/bin/dbt
USER airflow

# Lab-account login (FAB OAuth → Keycloak), the learners' DAG bundle (every <user>-lake/dags/)
# and the dag-id prefix policy — same files the local stack mounts.
COPY add/airflow_webserver_config.py /opt/airflow/webserver_config.py
COPY add/airflow_learner_dags.py /opt/airflow/lab/learner_dags.py
COPY add/airflow_local_settings.py /opt/airflow/lab/airflow_local_settings.py
# lab_spark() / run_notebook() for learner DAG tasks (+ lakehouse.py, which it uses)
COPY add/lab_spark.py /opt/airflow/lab/lab_spark.py
COPY add/lakehouse.py /opt/airflow/lab/lakehouse.py
