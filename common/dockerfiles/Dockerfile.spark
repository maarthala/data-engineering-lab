FROM spark:4.1.3-python3

USER root

RUN apt-get update && \
    apt-get install -y rsync zip && \
    apt-get clean

# postgres JDBC, AWS SDK v2 bundle + hadoop-aws (for s3a:// to the object store),
# JAXB (Hive metastore client on Java 11+), and Apache Iceberg (REST catalog).
COPY ./tmp/postgresql-42.6.0.jar /opt/spark/jars/
COPY ./tmp/bundle-2.29.52.jar /opt/spark/jars/
COPY ./tmp/hadoop-aws-3.4.2.jar /opt/spark/jars/
COPY ./tmp/javax.activation-api-1.2.0.jar /opt/spark/jars/
COPY ./tmp/jaxb-api-2.3.1.jar /opt/spark/jars/
COPY ./tmp/jaxb-impl-2.3.1.jar /opt/spark/jars/
COPY ./tmp/iceberg-spark-runtime-4.1_2.13-1.11.0.jar /opt/spark/jars/
COPY ./tmp/iceberg-aws-bundle-1.11.0.jar /opt/spark/jars/

# The AWS SDK v2 "bundle" ships an *unrelocated, older* io.netty that lacks
# PlatformDependent.newFixedMpscUnpaddedQueue(int). Because it sorts before
# netty-common on the /opt/spark/jars/* classpath, that stale netty wins and
# breaks Spark 4's netty RPC ("NoSuchMethodError ... newFixedMpscUnpaddedQueue"),
# killing the executor<->worker handshake and, in turn, every Spark job.
# Strip io.netty from the bundle so Spark's own netty-common-4.2.x is
# authoritative; S3A uses the Apache (sync) HTTP client, so it needs no netty.
# (bundle 2.29.x already relocates its netty under software/amazon/awssdk/thirdparty,
# so this is now a no-op safety net — keep it for older bundles.)
RUN zip -q -d /opt/spark/jars/bundle-2.29.52.jar 'io/netty/*' 'META-INF/native/libnetty*' || true

# NOTE: hive-exec-3.1.3 / hive-hcatalog-core-3.1.2 are deliberately NOT added.
# They shadow Spark 4's commons-lang3-3.17 (NoSuchFieldError JAVA_21) and were
# only ever removed again at container startup. Spark 4 talks to the Hive
# Metastore with its own bundled hive-2.3.10 client; Iceberg is accessed via the
# REST catalog (see spark-defaults.conf), so these jars are pure conflict.

# Delta Lake table format. Baked onto the system classpath —
# supplying it per-job via --packages fails on local[*] because DeltaCatalog is
# referenced during session init before the ivy jars join the driver classpath
# (ClassNotFoundException: org.apache.spark.sql.delta.catalog.DeltaCatalog).
# Delta MUST be the build for this Spark line. Since 4.1 Delta publishes one artifact per
# Spark minor (delta-spark_<spark>_2.13); delta-spark_4.1_2.13 is compiled against Spark
# 4.1.0. A build for another Spark minor fails with NoClassDefFoundError as soon as Delta's
# data-source discovery runs (e.g. any spark.read). Keep in lockstep with the FROM above.
ARG DELTA_VER=4.4.0
ARG DELTA_SPARK=4.1
RUN cd /opt/spark/jars && \
    base=https://repo1.maven.org/maven2/io/delta && \
    curl -fsSL -O $base/delta-spark_${DELTA_SPARK}_2.13/${DELTA_VER}/delta-spark_${DELTA_SPARK}_2.13-${DELTA_VER}.jar && \
    curl -fsSL -O $base/delta-storage/${DELTA_VER}/delta-storage-${DELTA_VER}.jar && \
    curl -fsSL -O $base/delta-kernel-api/${DELTA_VER}/delta-kernel-api-${DELTA_VER}.jar && \
    curl -fsSL -O $base/delta-kernel-defaults/${DELTA_VER}/delta-kernel-defaults-${DELTA_VER}.jar

# Kafka for Structured Streaming (spark.readStream.format("kafka")): 📨 Pub/Sub topics in notebooks.
# The connector + what it needs that Spark doesn't ship (kafka-clients, commons-pool2) — the
# versions spark-sql-kafka 4.1.3's pom names. Keep in lockstep with the FROM above.
ARG SPARK_VER=4.1.3
RUN cd /opt/spark/jars && \
    m=https://repo1.maven.org/maven2 && \
    curl -fsSL -O $m/org/apache/spark/spark-sql-kafka-0-10_2.13/${SPARK_VER}/spark-sql-kafka-0-10_2.13-${SPARK_VER}.jar && \
    curl -fsSL -O $m/org/apache/spark/spark-token-provider-kafka-0-10_2.13/${SPARK_VER}/spark-token-provider-kafka-0-10_2.13-${SPARK_VER}.jar && \
    curl -fsSL -O $m/org/apache/kafka/kafka-clients/3.9.1/kafka-clients-3.9.1.jar && \
    curl -fsSL -O $m/org/apache/commons/commons-pool2/2.12.1/commons-pool2-2.12.1.jar

RUN chown spark:spark /opt/spark/jars/*.jar && chmod 644 /opt/spark/jars/*.jar

# pandas + pyarrow on the workers: pandas UDFs (@pandas_udf, applyInPandas) run here and
# fail with "No module named 'pandas'" without them. Same versions the Jupyter image (also
# Python 3.10) resolves, so client and workers serialize data the same way.
RUN python3 -m pip install --no-cache-dir "pandas==2.3.3" "numpy==2.2.6" "pyarrow==25.0.1"

USER spark
