# Home landing page image for Kubernetes.
#
# The landing page (index.html) is supplied at deploy time by the home-html
# ConfigMap (rewritten to the ingress hosts), subPath-mounted over nginx's
# default index — so this image is just a plain nginx.
#
# The training COURSE is NOT baked in. It's published to GitHub Pages
# (https://maarthala.github.io/data-engineering-lab/) by
# .github/workflows/docs.yml on every push to main, and the landing page links
# straight there — a single always-fresh source, so the course can never go
# stale inside this image.
#
# Build context is irrelevant (nothing is copied in):
#   docker build -f common/dockerfiles/Dockerfile.home -t <ref> .
FROM nginx:1.31.5
