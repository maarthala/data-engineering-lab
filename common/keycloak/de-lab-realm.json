{
  "realm": "de-lab",
  "displayName": "Epireum's Data Engineering Lab",
  "enabled": true,
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "loginWithEmailAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": true,
  "verifyEmail": false,
  "ssoSessionIdleTimeout": 7200,
  "ssoSessionMaxLifespan": 43200,
  "groups": [
    {
      "name": "learners"
    },
    {
      "name": "managers",
      "realmRoles": [
        "admin"
      ]
    }
  ],
  "defaultGroups": [
    "/learners"
  ],
  "clients": [
    {
      "clientId": "de-lab-home",
      "name": "DE Learning Lab \u2014 home page",
      "publicClient": false,
      "secret": "de-lab-home-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://lab.localhost:8000/oauth2/callback",
        "http://de.lan/oauth2/callback"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://lab.localhost:8000/*##http://de.lan/*"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "de-lab-home",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "jupyterhub",
      "name": "JupyterHub \u2014 one Jupyter per learner",
      "publicClient": false,
      "secret": "jupyterhub-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://jupyter.lab.localhost:8000/hub/oauth_callback",
        "http://jupyter.de.lan/hub/oauth_callback"
      ],
      "webOrigins": [
        "+"
      ],
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "storage",
      "name": "Storage console \u2014 SSO, own bucket only",
      "publicClient": false,
      "secret": "storage-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://storage.lab.localhost:8000/*",
        "http://storage.de.lan/*"
      ],
      "webOrigins": [
        "+"
      ],
      "protocolMappers": [
        {
          "name": "policy",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "user.attribute": "username",
            "claim.name": "policy",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "sqlpad",
      "name": "SQLPad \u2014 SQL workbench",
      "publicClient": false,
      "secret": "sqlpad-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://sqlpad.lab.localhost:8000/auth/oidc/callback",
        "http://sqlpad.de.lan/auth/oidc/callback"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://sqlpad.lab.localhost:8000/*##http://sqlpad.de.lan/*"
      },
      "webOrigins": [
        "+"
      ],
      "protocolMappers": [
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ],
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "basic"
      ]
    },
    {
      "clientId": "polaris",
      "name": "Polaris catalog API (token audience)",
      "publicClient": false,
      "secret": "polaris-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "bearerOnly": false
    },
    {
      "clientId": "polaris-ui",
      "name": "Polaris Console \u2014 sign in with the lab account",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://polaris-console.lab.localhost:8000/*",
        "http://polaris-console.de.lan/*"
      ],
      "webOrigins": [
        "http://polaris-console.lab.localhost:8000",
        "http://polaris-console.de.lan"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "principal_name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "user.attribute": "username",
            "claim.name": "principal_name",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "principal_roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "user.attribute": "username",
            "claim.name": "principal_roles",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "superset",
      "name": "Superset \u2014 dashboards",
      "publicClient": false,
      "secret": "superset-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://superset.lab.localhost:8000/oauth-authorized/keycloak",
        "http://superset.de.lan/oauth-authorized/keycloak"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://superset.lab.localhost:8000/*##http://superset.de.lan/*"
      },
      "webOrigins": [
        "+"
      ],
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "airflow",
      "name": "Airflow \u2014 orchestration",
      "publicClient": false,
      "secret": "airflow-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://airflow.lab.localhost:8000/auth/oauth-authorized/keycloak",
        "http://airflow.lab.localhost:8000/auth/oauth-authorized/keycloak",
        "http://airflow.de.lan/auth/oauth-authorized/keycloak"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://airflow.lab.localhost:8000/*##http://airflow.de.lan/*"
      },
      "webOrigins": [
        "+"
      ],
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "vault",
      "name": "Key vault \u2014 My secrets",
      "publicClient": false,
      "secret": "vault-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://vault.lab.localhost:8000/ui/vault/auth/oidc/oidc/callback",
        "http://localhost:8250/oidc/callback",
        "http://vault.de.lan/ui/vault/auth/oidc/oidc/callback"
      ],
      "webOrigins": [
        "+"
      ],
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "manager",
      "enabled": true,
      "email": "manager@de.lan",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "manager",
          "temporary": false
        }
      ],
      "groups": [
        "/managers"
      ]
    },
    {
      "username": "demouser",
      "enabled": true,
      "email": "demouser@de.lan",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "demouser",
          "temporary": false
        }
      ],
      "groups": [
        "/learners"
      ]
    },
    {
      "username": "learner2",
      "enabled": true,
      "email": "learner2@de.lan",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "learner2",
          "temporary": false
        }
      ],
      "groups": [
        "/learners"
      ]
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{},\"pattern\":{\"pattern\":\"^[a-z0-9]{3,30}$\",\"error-message\":\"Use 3\\u201330 lowercase letters and digits (it also names your lakehouse and storage bucket).\"}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"${email}\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"permissions\":{\"view\":[\"admin\"],\"edit\":[\"admin\"]},\"multivalued\":false}],\"groups\":[{\"name\":\"user-metadata\",\"displayHeader\":\"User metadata\",\"displayDescription\":\"Attributes, which refer to user metadata\"}]}"
          ]
        }
      }
    ]
  },
  "loginTheme": "de-lab",
  "displayNameHtml": "Epireum&#39;s Data Engineering Lab<span class=\"tag\">Your gateway to a Data Engineering career</span>",
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Lab managers \u2014 admin in SQLPad / tools that read a `roles` claim"
      }
    ]
  }
}
