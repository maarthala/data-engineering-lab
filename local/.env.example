# Copy this to `.env` and fill in secrets — `.env` is gitignored, never commit it:
#   cp .env.example .env
#
# docker compose reads `.env` automatically (compose files + service variables).

# Host UID the Airflow containers run as — match your host (`id -u`) on Linux.
AIRFLOW_UID=50000

# Host ports that commonly clash with other local projects (defaults shown).
# POSTGRES_HOST_PORT=5432
# AIRFLOW_HOST_PORT=8001

# Single source of truth for the compose files that make up the stack. docker
# compose reads COMPOSE_FILE automatically, so `docker compose up`, env-up.sh, and
# the Makefile all target the same services. Paths are relative to this directory.
COMPOSE_FILE=base.yaml:db.yaml:storage.yaml:trino.yaml:spark.yaml:airflow.yaml:jupyter.yaml:superset.yaml:sqlpad.yaml:home.yaml:polaris.yaml:keycloak.yaml:jupyterhub.yaml:vault.yaml

# --- Jupyter notebook auto-push (git commit + push on every save) ---
# Jupyter clones GIT_REPO_URL and pushes each save (put notebooks under notebooks/).
# The TOKEN is the pushing account and needs Contents: Read+Write on the repo.
# Leave GIT_TOKEN blank to disable auto-push. NEVER commit a real token.
#   quick fill:  GIT_TOKEN=$(gh auth token)   (uses your gh-authenticated account)
GIT_AUTOPUSH=1
GIT_REPO_URL=https://github.com/dev-epireum-com/de-lab.git
GIT_BRANCH=main
GIT_USERNAME=x-access-token
GIT_TOKEN=
GIT_AUTHOR_NAME=notebook
GIT_AUTHOR_EMAIL=notebook@de.lan

# --- "Newer release" banner (managers only, on the home page) ---
# home-api asks GitHub at most once an hour for the latest vX.Y.Z tag of the lab's repo and, if it
# is newer than this checkout, tells managers to git pull. 0 = don't check.
LAB_UPDATE_CHECK=1
